# =============================================================================
# Cognita RAG - Environment Configuration Template
# Copy this file to .env and fill in your values
# =============================================================================

# DeepSeek API Configuration
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
DEEPSEEK_REASONING_MODEL=deepseek-v4-pro

# Embedding Configuration (Local - Free, runs on CPU/GPU)
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIMENSION=512
EMBEDDING_DEVICE=cpu  # cpu | cuda | mps

# Vector Store Configuration
VECTOR_STORE_TYPE=qdrant  # qdrant | memory
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=cognita_docs
QDRANT_API_KEY=  # Optional: set if Qdrant requires authentication

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=  # Set to enable API key authentication
CORS_ORIGINS=*  # Comma-separated list of allowed origins

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60  # seconds

# Observability
LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR
ENABLE_METRICS=true
ENABLE_TRACING=false
OTEL_ENDPOINT=http://localhost:4317

# Application
APP_NAME=Cognita RAG
APP_VERSION=1.0.0
ENVIRONMENT=production  # development | staging | production
